<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_bg"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="28dp"
    android:paddingBottom="28dp">

    <!-- Drag handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#CCCCCC"
        android:layout_marginBottom="20dp" />

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="Reserve Now"
        android:textColor="#1F6F5F"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvTripName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#2FA084"
        android:textSize="13sp"
        android:layout_marginBottom="20dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#DDDDDD"
        android:layout_marginBottom="20dp" />

    <!-- Participation Count -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Participation Count"
        android:textColor="#1F6F5F"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="22dp">

        <TextView
            android:id="@+id/btnMinus"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="-"
            android:textSize="20sp"
            android:textColor="#1F6F5F"
            android:background="@drawable/qty_btn_bg"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvQuantity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="1"
            android:textColor="#1F6F5F"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/btnPlus"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="+"
            android:textSize="20sp"
            android:textColor="#EEEEEE"
            android:background="@drawable/qty_btn_filled_bg"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Reservation Type -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reservation Type"
        android:textColor="#1F6F5F"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <Spinner
        android:id="@+id/spinnerReservationType"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/spinner_outline_bg"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginBottom="20dp" />

    <!-- Total Price -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/stat_card_bg"
        android:padding="12dp"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Total Price"
            android:textColor="#1F6F5F"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTotalPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#2FA084"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Confirm Button -->
    <Button
        android:id="@+id/btnConfirm"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="CONFIRM RESERVATION"
        android:textColor="#EEEEEE"
        android:textSize="13sp"
        android:textStyle="bold"
        android:backgroundTint="#1F6F5F"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnCancel"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:backgroundTint="#EEEEEE"
        android:text="Cancel"
        android:textColor="#2FA084"
        android:textSize="13sp" />

</LinearLayout>