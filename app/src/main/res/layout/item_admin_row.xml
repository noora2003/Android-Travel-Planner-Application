<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvRowTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Title"
                    android:textColor="#0D530E"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRowSub1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sub 1"
                    android:textColor="#555"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvRowSub2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sub 2"
                    android:textColor="#777"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnRowEdit"
                    android:layout_width="60dp"
                    android:layout_height="32dp"
                    android:text="Edit"
                    android:textSize="11sp"
                    android:backgroundTint="#2FA084"
                    android:visibility="gone"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnRowDelete"
                    android:layout_width="60dp"
                    android:layout_height="32dp"
                    android:text="Delete"
                    android:textSize="11sp"
                    android:backgroundTint="#A32D2D" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>