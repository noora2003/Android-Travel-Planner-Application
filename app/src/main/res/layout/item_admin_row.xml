<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Colored top accent bar -->
        <View
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:background="#2FA084" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="14dp"
            android:gravity="center_vertical">

            <!-- Avatar circle -->
            <LinearLayout
                android:id="@+id/llAvatar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/circle_green_bg"
                android:gravity="center"
                android:layout_marginEnd="12dp">
                <TextView
                    android:id="@+id/tvAvatarLetter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="?"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Content -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvRowTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Title"
                    android:textColor="#0D530E"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="3dp" />

                <TextView
                    android:id="@+id/tvRowSub1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sub 1"
                    android:textColor="#444"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvRowSub2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sub 2"
                    android:textColor="#888780"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Action buttons -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <Button
                    android:id="@+id/btnRowEdit"
                    android:layout_width="70dp"
                    android:layout_height="32dp"
                    android:text="Edit"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2FA084"
                    android:visibility="gone"
                    android:layout_marginBottom="6dp" />

                <Button
                    android:id="@+id/btnRowDelete"
                    android:layout_width="70dp"
                    android:layout_height="32dp"
                    android:text="Delete"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#C0392B" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>