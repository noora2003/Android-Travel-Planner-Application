<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_bg"
    android:padding="24dp">

    <!-- Title -->
    <TextView
        android:id="@+id/tvReserveTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Make a Reservation"
        android:textColor="#0D530E"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fill in the details below to confirm your booking"
        android:textColor="#888780"
        android:textSize="12sp"
        android:layout_marginBottom="22dp" />

    <!-- Quantity -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Number of Travelers"
        android:textColor="#1F6F56"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:boxStrokeColor="#1F6F56"
        app:hintTextColor="#1F6F56">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. 2"
            android:inputType="number"
            android:textColor="#1F6F56" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Reservation Type -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reservation Type"
        android:textColor="#1F6F56"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <Spinner
        android:id="@+id/spinnerReserveType"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/spinner_bg"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginBottom="24dp" />

    <!-- Buttons -->
    <Button
        android:id="@+id/btnConfirmReserve"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Confirm Reservation"
        android:textColor="#E7E1B1"
        android:textSize="15sp"
        android:textStyle="bold"
        android:backgroundTint="#0D530E"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnCancelReserve"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:strokeColor="#1F6F56"
        app:strokeWidth="1dp"
        android:text="Cancel"
        android:textColor="#1F6F56" />

</LinearLayout>